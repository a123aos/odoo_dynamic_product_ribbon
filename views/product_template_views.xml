<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_variant_easy_edit_view_group_id" model="ir.ui.view">
        <field name="name">product.product.form.easy.product.group.id</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='codes']/field[@name='default_code']" position="after">
                <field name="schema_product_group_id"
                       string="Product Group ID (shared)"
                       placeholder="KF1-NH-MR"/>
            </xpath>
        </field>
    </record>
</odoo>
